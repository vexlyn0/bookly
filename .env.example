# Server
PORT=3000
NODE_ENV=development

# Supabase Auth (обязательно для входа и регистрации)
# Dashboard → Project Settings → API → Project URL (БЕЗ /rest/v1/)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon public ИЛИ новый Publishable key (sb_publishable_...)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Альтернативное имя для Publishable key:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Только на сервере — не публикуйте в браузере (для будущих API)
SUPABASE_SERVICE_ROLE_KEY=

# Для миграций схемы (Supabase → Database → Connection string)
DATABASE_URL=

# Реквизиты Kaspi для ручной оплаты (только сервер, не публикуйте в GitHub)
KASPI_PAYMENT_RECIPIENT=
KASPI_PAYMENT_PHONE=
KASPI_PAYMENT_INSTRUCTIONS=

# Для npm run test:services (интеграционный тест CRUD)
TEST_EMAIL=
TEST_EMAIL_B=
TEST_PASSWORD=

# Telegram (будущие уведомления)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
