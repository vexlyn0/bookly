# Server
# REQUIRED in production (Render sets PORT automatically)
PORT=3000
NODE_ENV=development

# =============================================================================
# REQUIRED — Supabase Auth + server APIs
# Dashboard → Project Settings → API → Project URL (БЕЗ /rest/v1/)
# =============================================================================
SUPABASE_URL=

# anon public ИЛИ Publishable key (sb_publishable_...)
# REQUIRED (alias: SUPABASE_PUBLISHABLE_KEY)
SUPABASE_ANON_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Только на сервере — НИКОГДА не отдавать браузеру / не коммитить
# REQUIRED (alias: SUPABASE_SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# =============================================================================
# OPTIONAL — Kaspi manual billing (все три сразу, иначе configured=false)
# =============================================================================
KASPI_PAYMENT_RECIPIENT=
KASPI_PAYMENT_PHONE=
KASPI_PAYMENT_INSTRUCTIONS=

# =============================================================================
# OPTIONAL — Telegram-уведомления сотрудникам (см. docs/TELEGRAM.md)
# =============================================================================
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Случайная строка 16–256 символов [A-Za-z0-9_-]; без неё webhook выключен
TELEGRAM_WEBHOOK_SECRET=
# Username бота без @ (если пусто — берётся через getMe при старте)
TELEGRAM_BOT_USERNAME=

# =============================================================================
# TEST / LOCAL ONLY — не добавлять в Render production
# =============================================================================
# Для npm run validate:* / setup-* (миграции схемы)
DATABASE_URL=
# SUPABASE_DB_URL=

# Для интеграционных тестов
TEST_EMAIL=
TEST_EMAIL_B=
TEST_PASSWORD=
TEST_PASSWORD_B=

# Обход rate-limit в тестах (только локально)
# BOOKLY_DISABLE_BOOKING_RATE_LIMIT=1
# BOOKLY_DISABLE_BILLING_RATE_LIMIT=1
